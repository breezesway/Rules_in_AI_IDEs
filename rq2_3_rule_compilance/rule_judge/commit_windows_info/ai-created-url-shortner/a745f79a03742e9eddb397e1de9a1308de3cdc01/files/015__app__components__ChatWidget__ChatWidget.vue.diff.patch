-const emit = defineEmits<{
-  messagesSent: [messages: ChatMessage[]];
-  minimizeToggle: [minimized: boolean];
-}>();
-
-// Local state
-const messages = ref<ChatMessage[]>([
-  {
-    id: "1",
-    content: "Hello! How can I help you today?",
-    timestamp: new Date(),
-    sender: "bot",
-  },
-]);
-
-const newMessage = ref("");
