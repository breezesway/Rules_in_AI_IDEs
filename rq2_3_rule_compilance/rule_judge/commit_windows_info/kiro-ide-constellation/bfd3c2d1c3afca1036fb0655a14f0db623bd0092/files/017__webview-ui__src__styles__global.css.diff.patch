diff --git a/webview-ui/src/styles/global.css b/webview-ui/src/styles/global.css
index 78c152e..ef0e883 100644
--- a/webview-ui/src/styles/global.css
+++ b/webview-ui/src/styles/global.css
@@ -294,3 +294,440 @@ body {
   }
 }
 
+
+/* Onboarding Mode Toggle Styles */
+.onboarding-mode-toggle {
+  padding: 12px;
+  border-bottom: 1px solid var(--vscode-widget-border);
+  background: var(--vscode-editorWidget-background);
+}
+
+.mode-toggle-header {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 8px;
+}
+
+.mode-toggle-label {
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--vscode-foreground);
+  min-width: 40px;
+}
+
+.mode-toggle-controls {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex: 1;
+}
+
+.mode-toggle-dropdown {
+  flex: 1;
+  padding: 4px 8px;
+  font-size: 12px;
+  background: var(--vscode-dropdown-background);
+  color: var(--vscode-dropdown-foreground);
+  border: 1px solid var(--vscode-dropdown-border);
+  border-radius: 4px;
+  outline: none;
+  cursor: pointer;
+}
+
+.mode-toggle-dropdown:focus {
+  border-color: var(--vscode-focusBorder);
+}
+
+.mode-toggle-dropdown:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+}
+
+.mode-toggle-spinner {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+}
+
+.spinner {
+  display: inline-block;
+  animation: spin 1s linear infinite;
+  font-size: 12px;
+  color: var(--vscode-progressBar-background);
+}
+
+@keyframes spin {
+  from { transform: rotate(0deg); }
+  to { transform: rotate(360deg); }
+}
+
+.mode-toggle-status {
+  display: flex;
+  align-items: center;
+  margin-bottom: 4px;
+}
+
+.mode-indicator {
+  font-size: 11px;
+  font-weight: 500;
+  padding: 2px 6px;
+  border-radius: 10px;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+}
+
+.mode-indicator-default {
+  background: var(--vscode-badge-background);
+  color: var(--vscode-badge-foreground);
+}
+
+.mode-indicator-onboarding {
+  background: var(--vscode-charts-blue, #007ACC);
+  color: var(--vscode-badge-foreground);
+}
+
+.mode-toggle-error {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 6px 8px;
+  background: var(--vscode-inputValidation-errorBackground);
+  border: 1px solid var(--vscode-inputValidation-errorBorder);
+  border-radius: 4px;
+  margin-top: 8px;
+  font-size: 11px;
+}
+
+.error-icon {
+  color: var(--vscode-errorForeground);
+  font-weight: bold;
+}
+
+.error-message {
+  flex: 1;
+  color: var(--vscode-errorForeground);
+}
+
+.error-dismiss {
+  padding: 0 4px;
+  font-size: 14px;
+  line-height: 1;
+  background: transparent;
+  border: none;
+  color: var(--vscode-errorForeground);
+  cursor: pointer;
+  border-radius: 2px;
+}
+
+.error-dismiss:hover {
+  background: var(--vscode-button-hoverBackground);
+}
+
+/* Modal Dialog Styles */
+.modal-overlay {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: rgba(0, 0, 0, 0.5);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 1000;
+}
+
+.modal-dialog {
+  background: var(--vscode-editorWidget-background);
+  border: 1px solid var(--vscode-widget-border);
+  border-radius: 6px;
+  min-width: 320px;
+  max-width: 480px;
+  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
+}
+
+.modal-header {
+  padding: 16px 16px 0 16px;
+}
+
+.modal-title {
+  margin: 0;
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--vscode-foreground);
+}
+
+.modal-body {
+  padding: 12px 16px;
+}
+
+.modal-message {
+  margin: 0;
+  font-size: 12px;
+  line-height: 1.4;
+  color: var(--vscode-descriptionForeground);
+}
+
+.modal-footer {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  padding: 0 16px 16px 16px;
+}
+
+.modal-button {
+  padding: 6px 12px;
+  font-size: 12px;
+  border-radius: 4px;
+  cursor: pointer;
+  border: 1px solid transparent;
+}
+
+.modal-button-secondary {
+  background: var(--vscode-button-secondaryBackground);
+  color: var(--vscode-button-secondaryForeground);
+  border-color: var(--vscode-button-border);
+}
+
+.modal-button-secondary:hover:not(:disabled) {
+  background: var(--vscode-button-secondaryHoverBackground);
+}
+
+.modal-button-primary {
+  background: var(--vscode-button-background);
+  color: var(--vscode-button-foreground);
+  border-color: var(--vscode-button-border);
+}
+
+.modal-button-primary:hover:not(:disabled) {
+  background: var(--vscode-button-hoverBackground);
+}
+
+.modal-button:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+}
+
+/* Focus styles for modal */
+.modal-button:focus {
+  outline: 2px solid var(--vscode-focusBorder);
+  outline-offset: 2px;
+}
+
+.mode-toggle-dropdown:focus {
+  outline: 2px solid var(--vscode-focusBorder);
+  outline-offset: 2px;
+}
+
+/* Onboarding Status Styles */
+.onboarding-status {
+  border-bottom: 1px solid var(--vscode-widget-border);
+  background: var(--vscode-editorWidget-background);
+}
+
+.onboarding-status-active {
+  padding: 12px;
+}
+
+.onboarding-status-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 8px;
+}
+
+.onboarding-status-indicator {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.status-icon {
+  font-size: 14px;
+}
+
+.status-label {
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--vscode-foreground);
+}
+
+.onboarding-status-progress {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 120px;
+}
+
+.progress-text {
+  font-size: 11px;
+  color: var(--vscode-descriptionForeground);
+  white-space: nowrap;
+}
+
+.progress-bar {
+  flex: 1;
+  height: 4px;
+  background: var(--vscode-progressBar-background, var(--vscode-widget-border));
+  border-radius: 2px;
+  overflow: hidden;
+  min-width: 60px;
+}
+
+.progress-fill {
+  height: 100%;
+  background: var(--vscode-charts-blue, #007ACC);
+  border-radius: 2px;
+  transition: width 0.3s ease;
+}
+
+.onboarding-status-details {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.onboarding-status-file {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 6px;
+  background: var(--vscode-badge-background);
+  border-radius: 4px;
+}
+
+.file-icon {
+  font-size: 12px;
+}
+
+.file-path {
+  font-size: 11px;
+  font-family: var(--vscode-editor-font-family, 'Consolas', 'Courier New', monospace);
+  color: var(--vscode-badge-foreground);
+  word-break: break-all;
+}
+
+.onboarding-status-explanation {
+  padding: 6px 8px;
+  background: var(--vscode-textBlockQuote-background, var(--vscode-editorWidget-background));
+  border-left: 3px solid var(--vscode-charts-blue, #007ACC);
+  border-radius: 0 4px 4px 0;
+}
+
+.explanation-text {
+  margin: 0;
+  font-size: 11px;
+  line-height: 1.4;
+  color: var(--vscode-foreground);
+}
+
+.onboarding-status-complete {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 8px 12px;
+  background: var(--vscode-inputValidation-infoBackground, var(--vscode-charts-green));
+  border: 1px solid var(--vscode-inputValidation-infoBorder, var(--vscode-charts-green));
+  color: var(--vscode-inputValidation-infoForeground, var(--vscode-foreground));
+}
+
+.complete-content {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.complete-icon {
+  font-size: 14px;
+}
+
+.complete-message {
+  font-size: 12px;
+  font-weight: 500;
+}
+
+.complete-dismiss {
+  padding: 0 4px;
+  font-size: 14px;
+  line-height: 1;
+  background: transparent;
+  border: none;
+  color: var(--vscode-inputValidation-infoForeground, var(--vscode-foreground));
+  cursor: pointer;
+  border-radius: 2px;
+}
+
+.complete-dismiss:hover {
+  background: rgba(255, 255, 255, 0.1);
+}
+
+.onboarding-status-error {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 8px 12px;
+  background: var(--vscode-inputValidation-errorBackground);
+  border: 1px solid var(--vscode-inputValidation-errorBorder);
+  color: var(--vscode-inputValidation-errorForeground, var(--vscode-errorForeground));
+}
+
+.error-content {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  flex: 1;
+}
+
+.error-icon {
+  font-size: 14px;
+  color: var(--vscode-errorForeground);
+}
+
+.error-message {
+  font-size: 11px;
+  line-height: 1.3;
+  color: var(--vscode-errorForeground);
+}
+
+.error-dismiss {
+  padding: 0 4px;
+  font-size: 14px;
+  line-height: 1;
+  background: transparent;
+  border: none;
+  color: var(--vscode-errorForeground);
+  cursor: pointer;
+  border-radius: 2px;
+}
+
+.error-dismiss:hover {
+  background: rgba(255, 255, 255, 0.1);
+}
+
+/* Focus styles for onboarding status */
+.complete-dismiss:focus,
+.error-dismiss:focus {
+  outline: 2px solid var(--vscode-focusBorder);
+  outline-offset: 2px;
+}
+
+/* Responsive design for onboarding status */
+@media (max-width: 768px) {
+  .onboarding-status-header {
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 8px;
+  }
+  
+  .onboarding-status-progress {
+    width: 100%;
+    min-width: unset;
+  }
+  
+  .progress-text {
+    min-width: 80px;
+  }
+}
