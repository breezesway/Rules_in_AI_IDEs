diff --git a/src/index.css b/src/index.css
index ebbb620..41a11fc 100644
--- a/src/index.css
+++ b/src/index.css
@@ -29,3 +29,27 @@
   flex-direction: column;
   text-align: left;
 }
+
+.link-styling {
+	font-weight: 500;
+	color: #222;
+	text-decoration: none;
+	position: relative;
+}
+.link-styling::after {
+	content: '';
+	display: block;
+	position: absolute;
+	left: 0;
+	bottom: 0.05em;
+	height: 0.22em;
+	width: 100%;
+	background: linear-gradient(90deg, rgba(11, 208, 188, 0.549) 0%, rgba(25, 238, 217, 0.521) 100%);
+	border-radius: 2px;
+	transition: height 0.28s cubic-bezier(.4,0,.2,1), background 0.28s cubic-bezier(.4,0,.2,1);
+	z-index: 0;
+}
+.link-styling:hover::after, .link-styling:focus::after {
+	height: 100%;
+	background: linear-gradient(90deg, rgba(11, 208, 188, 0.276) 0%, rgba(25, 238, 217, 0.339) 100%);
+}
