 [tool:pytest]
+# Pytest configuration for YouTube-to-Notion integration tests
+
+# Test discovery
 testpaths = tests
 python_files = test_*.py
 python_classes = Test*
 python_functions = test_*
+
+# Markers
+markers =
+    unit: Unit tests (fast, no external dependencies)
+    integration: Integration tests (require API keys and external services)
+    slow: Slow tests (may take significant time to complete)
+    external_api: Tests that call external APIs
+    database_cleanup: Tests that require database cleanup
+
+# Output options
 addopts = 
-    -v
+    --strict-markers
     --tb=short
-    --strict-config
-    --durations=10
-    --cov=src/youtube_notion
-    --cov-report=term-missing
-    --cov-report=html:htmlcov
-pythonpath = . src config
-markers =
-    slow: marks tests as slow (deselect with '-m "not slow"')
-    integration: marks tests as integration tests requiring API keys
-    unit: marks tests as unit tests
+    --disable-warnings
+    -ra
+
+# Test filtering
 filterwarnings =
     ignore::DeprecationWarning
-    ignore::PendingDeprecationWarning
\ No newline at end of file
+    ignore::PendingDeprecationWarning
+
+# Minimum version
+minversion = 6.0
+
+# Test timeout (for integration tests)
+timeout = 300
+
+# Coverage options (if pytest-cov is installed)
+# addopts = --cov=src/youtube_notion --cov-report=term-missing --cov-report=html
\ No newline at end of file
