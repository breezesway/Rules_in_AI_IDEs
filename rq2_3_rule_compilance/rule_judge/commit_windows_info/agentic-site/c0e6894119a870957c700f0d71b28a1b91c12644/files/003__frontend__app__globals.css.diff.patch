+/* Font Variables */
+:root {
+  --font-bitter: 'Bitter', serif;
+  --font-noto-arabic: 'Noto Sans Arabic', sans-serif;
+}
+
+/* Improved Typography */
+.hero-title {
+  font-size: clamp(2.5rem, 5vw, 4rem) !important;
+  font-weight: 600 !important;
+  line-height: 1.2 !important;
+  letter-spacing: -0.02em !important;
+}
+
+.hero-subtitle {
+  font-size: clamp(1.1rem, 2.5vw, 1.25rem) !important;
+  font-weight: 400 !important;
+  line-height: 1.6 !important;
+  opacity: 0.9 !important;
+}
+
+/* Arabic Font Improvements */
+[dir="rtl"] .hero-title,
+[lang="ar"] .hero-title {
+  font-family: var(--font-noto-arabic) !important;
+  font-weight: 500 !important;
+}
+
+[dir="rtl"] .hero-subtitle,
+[lang="ar"] .hero-subtitle {
+  font-family: var(--font-noto-arabic) !important;
+  font-weight: 400 !important;
+}
+
+/* Navigation Improvements */
+.nav-transparent {
+  background: rgba(255, 255, 255, 0.1) !important;
+  backdrop-filter: blur(10px) !important;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
+}
+
+.nav-scrolled {
+  background: rgba(255, 255, 255, 0.95) !important;
+  backdrop-filter: blur(10px) !important;
+  border-bottom: 1px solid rgba(0, 0, 0, 0.1) !important;
+}
+
+/* Dark mode navigation */
+.dark .nav-transparent {
+  background: rgba(0, 0, 0, 0.1) !important;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
+}
+
+.dark .nav-scrolled {
+  background: rgba(0, 0, 0, 0.95) !important;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
+}
+
+/* Reduce spacing between hero and nav */
+.hero-section {
+  padding-top: 6rem !important;
+}
+
+/* Mobile responsive improvements */
+@media (max-width: 768px) {
+  .hero-title {
+    font-size: 2.25rem !important;
+    line-height: 1.1 !important;
+  }
+  
+  .hero-subtitle {
+    font-size: 1rem !important;
+    line-height: 1.5 !important;
+  }
+  
+  .hero-section {
+    padding-top: 5rem !important;
+  }
+}
