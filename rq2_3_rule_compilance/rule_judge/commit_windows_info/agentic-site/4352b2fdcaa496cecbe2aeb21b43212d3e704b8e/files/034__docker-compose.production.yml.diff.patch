diff --git a/docker-compose.production.yml b/docker-compose.production.yml
index 43f41a0..d2376aa 100644
--- a/docker-compose.production.yml
+++ b/docker-compose.production.yml
@@ -29,7 +29,7 @@ services:
 
   backend:
     build:
-      context: ./agent
+      context: ./backend
       dockerfile: Dockerfile
     container_name: agentic-backend-prod
     ports:
@@ -37,6 +37,10 @@ services:
     environment:
       - ENVIRONMENT=production
       - PORT=8000
+      - REDIS_URL=redis://redis:6379/0
+      - CELERY_BROKER_URL=redis://redis:6379/0
+      - CELERY_RESULT_BACKEND=redis://redis:6379/0
+      - N8N_URL=http://n8n:5678
     env_file:
       - .env.production
     restart: unless-stopped
@@ -49,6 +53,63 @@ services:
     depends_on:
       - redis
 
+  # Celery Worker Service
+  celery-worker:
+    build:
+      context: ./backend
+      dockerfile: Dockerfile
+    container_name: agentic-celery-worker-prod
+    command: celery -A agentic_core.tasks.celery_app worker --loglevel=info --queues=agent_queue,workflow_queue
+    environment:
+      - ENVIRONMENT=production
+      - REDIS_URL=redis://redis:6379/0
+      - CELERY_BROKER_URL=redis://redis:6379/0
+      - CELERY_RESULT_BACKEND=redis://redis:6379/0
+      - N8N_URL=http://n8n:5678
+    env_file:
+      - .env.production
+    restart: unless-stopped
+    depends_on:
+      - redis
+      - backend
+
+  # Celery Beat Service (Scheduler)
+  celery-beat:
+    build:
+      context: ./backend
+      dockerfile: Dockerfile
+    container_name: agentic-celery-beat-prod
+    command: celery -A agentic_core.tasks.celery_app beat --loglevel=info
+    environment:
+      - ENVIRONMENT=production
+      - REDIS_URL=redis://redis:6379/0
+      - CELERY_BROKER_URL=redis://redis:6379/0
+      - CELERY_RESULT_BACKEND=redis://redis:6379/0
+    env_file:
+      - .env.production
+    restart: unless-stopped
+    depends_on:
+      - redis
+      - backend
+
+  # Flower Service (Celery Monitoring)
+  flower:
+    build:
+      context: ./backend
+      dockerfile: Dockerfile
+    container_name: agentic-flower-prod
+    command: celery -A agentic_core.tasks.celery_app flower --port=5555 --broker=redis://redis:6379/0
+    ports:
+      - "5555:5555"
+    environment:
+      - CELERY_BROKER_URL=redis://redis:6379/0
+      - CELERY_RESULT_BACKEND=redis://redis:6379/0
+      - FLOWER_BASIC_AUTH=${FLOWER_BASIC_AUTH:-admin:admin}
+    restart: unless-stopped
+    depends_on:
+      - redis
+      - celery-worker
+
   redis:
     image: redis:7-alpine
     container_name: agentic-redis-prod
