+        const minutes = now.getMinutes();
+        const seconds = now.getSeconds();
+        const milliseconds = now.getMilliseconds();
+        
+        // Create new date in local timezone
+        return new Date(year, month, day, hours, minutes, seconds, milliseconds);
+    }
