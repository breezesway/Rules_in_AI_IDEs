+      addBattleLog(`你${source ? `从${source.name}受到` : '受到'}伤害，但不起作用！`);
+    }
+  }
+
+  if (target.hp <= 0) {
+    addDeathLog(`${target.name} 被击败了！`);
+    return { dead: true, passThoughDamage, hpDamage };
+  }
+
+  return { dead: false, passThoughDamage, hpDamage };
+}
