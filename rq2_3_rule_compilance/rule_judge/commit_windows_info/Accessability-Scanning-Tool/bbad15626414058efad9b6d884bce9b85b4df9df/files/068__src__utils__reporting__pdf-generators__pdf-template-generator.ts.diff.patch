+                <div class="performance-grid">
+                    <div class="performance-item">
+                        <span class="value">${totalScanTime}</span>
+                        <div class="label">Total Scan Time</div>
+                    </div>
+                    <div class="performance-item">
+                        <span class="value">${avgTimePerPage}</span>
+                        <div class="label">Average Time Per Page</div>
+                    </div>
