+                    oscillator.frequency.setValueAtTime(220, this.audioContext.currentTime); // A3
+                    oscillator.frequency.exponentialRampToValueAtTime(196, this.audioContext.currentTime + 0.3); // G3
+                    oscillator.type = 'square';
